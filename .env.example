export AI4SCIENCE_BASE_URL="https://ai4science.dev.sdp.surf.nl"
export SLURM_USER="your_snellius_user"
export SLURM_TOKEN="..."

# optional, default 10 (seconds)
export AI4SCIENCE_POLL_INTERVAL=1

# optional: maintainers only, to approve community tools in the demo notebook
export AI4SCIENCE_REVIEWER_KEY=""

# optional: your login on the MLflow server, for tracked jobs that log to
# their run themselves. Create a token in the MLflow UI (after SSO login).
# The username is your MLflow/SSO user name, which may differ from SLURM_USER.
export MLFLOW_TRACKING_USERNAME=""
export MLFLOW_TRACKING_PASSWORD=""
# or, if the server takes a bearer token instead:
# export MLFLOW_TRACKING_TOKEN=""